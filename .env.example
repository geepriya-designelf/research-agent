# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------
# Required to run any analysis. The SDK also accepts ANTHROPIC_AUTH_TOKEN or an
# `ant auth login` profile; you do not need to set this if one of those is set.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (optional)
# ---------------------------------------------------------------------------
# When both are present the app uses Postgres + Supabase Storage. When absent it
# falls back to a local file-backed store under .data/ so you can run it with no
# infrastructure. Apply supabase/migrations/0001_init.sql before first use.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=research-material

# ---------------------------------------------------------------------------
# Inngest (optional)
# ---------------------------------------------------------------------------
# When present, analysis runs as durable background jobs via /api/inngest.
# When absent, jobs run in-process, detached from the request.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
